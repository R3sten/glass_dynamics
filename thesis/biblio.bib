@article{sharmaInterpretabilityLinearRegression2026,
  title = {Interpretability of Linear Regression Models of Glassy Dynamics},
  author = {Sharma, Anand and Liu, Chen and Ozawa, Misaki and Coslovich, Daniele},
  date = {2026-03-02},
  journaltitle = {Physical Review Materials},
  shortjournal = {Phys. Rev. Mater.},
  volume = {10},
  number = {3},
  pages = {035602},
  publisher = {American Physical Society},
  doi = {10.1103/q6pd-7trs},
  abstract = {Data-driven models can accurately describe and predict the dynamical properties of glass-forming liquids from structural data. Accurate predictions, however, do not guarantee an understanding of the underlying physical phenomena and the key factors that control them. In this paper, we illustrate the merits and limitations of linear regression models of glassy dynamics built on high-dimensional structural descriptors. By analyzing data for a two-dimensional glass model, we show that several descriptors commonly used in glass-transition studies display multicollinearity, which hinders the interpretability of linear models. Ridge regression suppresses some of the shortcomings of multicollinearity, but its solutions are not concise enough to be physically interpretable. Only by using dimensional reduction techniques we do eventually obtain linear models that strike a balance between prediction accuracy and interpretability. Our analysis points to a key role of local packing and composition fluctuations in the glass model under study.},
  file = {C\:\\Users\\denis\\Zotero\\storage\\PCJWCVQZ\\Sharma et al. - 2026 - Interpretability of linear regression models of glassy dynamics.pdf;C\:\\Users\\denis\\Zotero\\storage\\HYWBBS4J\\q6pd-7trs.html}
}

@incollection{torraChapter4Data2023,
  title = {Chapter 4 - {{Data}} Privacy for Machine Learning and Statistics},
  booktitle = {Artificial {{Intelligence}}},
  author = {Torra, Vicenç},
  editor = {Krantz, Steven G. and Srinivasa Rao, Arni S. R. and Rao, C. R.},
  date = {2023-01-01},
  series = {Handbook of {{Statistics}}},
  volume = {49},
  pages = {103--128},
  publisher = {Elsevier},
  doi = {10.1016/bs.host.2023.06.003},
  abstract = {This chapter gives an overview of the field of data privacy for machine learning and statistics. We discuss privacy models as computational definitions of privacy. We show that they are different definitions based on different assumptions on what type of disclosure needs to be avoided. In particular, we present k-anonymity, privacy for re-identification, and differential privacy. These are the most established privacy models. They are useful for publishing a database or a computation from a database (e.g., the output of a function or query on a database). Then, we also present a few methods that are compliant with these privacy models. They are examples of those found in the literature for achieving good privacy levels. We also discuss in this text the need for finding a good trade-off between utility and privacy. We provide examples to illustrate both the definitions and the methods. Examples are for a small database, but the discussion is general and the same privacy models and data privacy methods apply to more complex databases. That is, they can be applied to non-SQL databases including graphs and social networks, text, or images.},
  keywords = {Data privacy,Privacy-preserving machine learning,Statistical disclosure control},
  file = {C:\Users\denis\Zotero\storage\B3HUSJ6J\S0169716123000275.html}
}
